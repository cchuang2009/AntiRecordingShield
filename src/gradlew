#!/usr/bin/env sh
# Lightweight fallback for environments with Gradle installed system-wide.
# For a fully portable wrapper, generate the standard Gradle wrapper in Android Studio.
if command -v gradle >/dev/null 2>&1; then
  exec gradle "$@"
fi
echo "Gradle is not installed. Open this project in Android Studio or install Gradle 8.13." >&2
exit 127
